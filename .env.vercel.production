# Created by Vercel CLI
# Safe template only. Set real values in Vercel Project Settings > Environment Variables.
AUTH_TOKEN_SECRET=<secret>
BCRYPT_SALT_ROUNDS=10
DB_CLIENT=postgres
DB_EXECUTION_MODE=postgres
CRON_SECRET=<secret>
EMAIL_VERIFY_BASE_URL=https://barmanstore.vercel.app/login
FRONTEND_ORIGIN=https://barmanstore.vercel.app
NX_DAEMON=false
PASSWORD_RESET_LOGIN_URL=https://barmanstore.vercel.app/login
PG_SSL=true
PG_SSL_REJECT_UNAUTHORIZED=false
POSTGRES_MIGRATIONS_DIR=./supabase/migrations
SUPABASE_AUTH_ENABLED=true
SUPABASE_AUTH_MODE=hybrid
SUPABASE_DB_URL=postgres://<user>:<password>@<host>:5432/<db>?sslmode=require
SUPABASE_EMAIL_VERIFY_REDIRECT=https://barmanstore.vercel.app/login
SUPABASE_PASSWORD_RESET_REDIRECT=https://barmanstore.vercel.app/login
PURCHASE_OPERATIONS_NOTIFICATIONS_ENABLED=true
TURBO_CACHE=false
TURBO_DOWNLOAD_LOCAL_ENABLED=false
TURBO_REMOTE_ONLY=false
TURBO_RUN_SUMMARY=false
VERCEL=true
VERCEL_ENV=production
VERCEL_GIT_COMMIT_AUTHOR_LOGIN=<ref>
VERCEL_GIT_COMMIT_AUTHOR_NAME=<ref>
VERCEL_GIT_COMMIT_MESSAGE=<ref>
VERCEL_GIT_COMMIT_REF=main
VERCEL_GIT_COMMIT_SHA=<ref>
VERCEL_GIT_PREVIOUS_SHA=<ref>
VERCEL_GIT_PROVIDER=github
VERCEL_GIT_PULL_REQUEST_ID=<ref>
VERCEL_GIT_REPO_ID=<ref>
VERCEL_GIT_REPO_OWNER=<ref>
VERCEL_GIT_REPO_SLUG=<ref>
VERCEL_OIDC_TOKEN=<token>
VERCEL_TARGET_ENV=production
VERCEL_URL=barmanstore.vercel.app
