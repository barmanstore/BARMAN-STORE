# Backend
PORT=5000
DB_CLIENT=postgres
DB_EXECUTION_MODE=postgres
# Supabase/Postgres
SUPABASE_DB_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_ENABLED=false
# hybrid = try Supabase first, fallback to legacy local auth
# strict = Supabase-only for email auth flows
SUPABASE_AUTH_MODE=hybrid
SUPABASE_EMAIL_VERIFY_REDIRECT=http://localhost:3000/login
POSTGRES_MIGRATIONS_DIR=supabase/migrations
PG_SSL=true
PG_SSL_REJECT_UNAUTHORIZED=false
PG_POOL_LIMIT=10
FRONTEND_ORIGIN=http://localhost:80,https://barman-store.vercel.app,https://barmanstore.vercel.app
CANONICAL_HOST=barmanstore.vercel.app
LEGACY_HOSTS=barman-store.vercel.app
BCRYPT_SALT_ROUNDS=10
# manual = operator-assisted delivery
# provider = auto-delivery first
AUTH_FLOW_MODE=manual
CREDIT_ENTRY_DEDUP_WINDOW_MS=15000

# OTP login settings
OTP_DELIVERY_MODE=manual
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_VERIFY_SESSION_TTL_SECONDS=900
AUTH_LOGIN_OTP_EXPOSE_CODE=true

# Email verification settings
# Use `stub` now (logs verification link in server console).
# Switch to `provider` later and set provider keys.
BUSINESS_NAME=BARMAN STORE
EMAIL_DELIVERY_MODE=manual
EMAIL_VERIFICATION_MODE=stub
EMAIL_VERIFY_BASE_URL=https://barmanstore.vercel.app/login
EMAIL_VERIFY_TTL_SECONDS=900
EMAIL_VERIFY_MAX_ATTEMPTS=5
EMAIL_API_KEY=
EMAIL_API_SECRET=
EMAIL_FROM=
PHONE_VERIFY_BASE_URL=https://barmanstore.vercel.app/login

# Frontend
# VITE_API_BASE_URL=http://localhost:5000
# Optional explicit OAuth callback URL (useful on mobile/LAN/custom base paths)
# VITE_OAUTH_REDIRECT_URL=http://localhost:3000/login
VITE_CANONICAL_HOST=barmanstore.vercel.app
VITE_LEGACY_HOSTS=barman-store.vercel.app
# Preferred image provider (Google Programmable Search)
# Create API key + CX and enable Custom Search JSON API.
# VITE_GOOGLE_CSE_API_KEY=your_google_api_key
# VITE_GOOGLE_CSE_ID=your_custom_search_engine_id

# Optional fallback provider
# VITE_UNSPLASH_ACCESS_KEY=your_unsplash_access_key

