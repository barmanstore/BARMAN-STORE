# Production deployment (Vercel)
# Keep empty to use same-origin /api on Vercel.
# If you must override, set to your deployed domain.
# VITE_API_BASE_URL=https://barman-store.vercel.app

# Root base path for Vercel deployments.
VITE_BASE_PATH=/

# Image search configuration (Google Programmable Search)
# VITE_GOOGLE_CSE_API_KEY=your_google_api_key
# VITE_GOOGLE_CSE_ID=your_custom_search_engine_id

# Optional fallback provider
# VITE_UNSPLASH_ACCESS_KEY=your_unsplash_access_key
