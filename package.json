{
  "name": "barman-store",
  "version": "1.0.0",
  "description": "BARMAN STORE - E-commerce Application with Supabase Postgres",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "bcrypt": "^5.1.0",
    "classnames": "^2.5.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "fuse.js": "^7.1.0",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.263.1",
    "pg": "^8.20.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@tailwindcss/postcss": "^4.1.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.24",
    "embedded-postgres": "^18.3.0-beta.16",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.0",
    "globals": "^17.5.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.3",
    "storybook": "^8.6.14",
    "stylelint": "^17.8.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.1.18",
    "vite": "^5.0.8"
  },
  "scripts": {
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "node scripts/storybook.mjs dev -p 6006",
    "build-storybook": "node scripts/storybook.mjs build",
    "stylelint": "stylelint \"src/**/*.css\"",
    "stylelint:fix": "stylelint --fix \"src/**/*.css\"",
    "build": "vite build",
    "lint": "eslint --ext .js,.jsx src",
    "test": "npm run test:phone && npm run test:order-flow && npm run test:po-lifecycle && npm run test:credit-ui && npm run test:category-tree && npm run test:stock-restock",
    "smoke:all": "npm run test:phone && npm run test:order-flow && npm run test:po-lifecycle && npm run test:credit-ui && npm run test:category-tree && npm run test:stock-restock",
    "smoke:local:phone": "node scripts/run-local-smoke-suite.mjs phone",
    "smoke:local:order-flow": "node scripts/run-local-smoke-suite.mjs order-flow",
    "smoke:local:po-lifecycle": "node scripts/run-local-smoke-suite.mjs po-lifecycle",
    "smoke:local:credit-ui": "node scripts/run-local-smoke-suite.mjs credit-ui",
    "smoke:local:category-tree": "node scripts/run-local-smoke-suite.mjs category-tree",
    "smoke:local:core": "node scripts/run-local-smoke-suite.mjs core",
    "smoke:local:all": "node scripts/run-local-smoke-suite.mjs all",
    "test:phone": "node scripts/test-phone-validation.mjs",
    "test:order-flow": "node scripts/test-order-billing-flow.mjs",
    "test:po-lifecycle": "node scripts/test-po-lifecycle-flow.mjs",
    "test:credit-ui": "node scripts/test-credit-history-ui.mjs && node scripts/test-credit-date-logic.mjs && node scripts/test-credit-history-routes.mjs",
    "test:category-tree": "node scripts/test-category-tree-rules.mjs",
    "test:stock-restock": "node scripts/test-stock-restock-routes.mjs",
    "test:modal-regression": "pwsh -File scripts/manual-modal-regression.ps1",
    "cleanup:smoke": "node scripts/cleanup-smoke-test-data.js --apply",
    "cleanup:smoke:verify": "node scripts/cleanup-smoke-test-data.js --fail-on-matches",
    "preview": "vite preview",
    "server": "node server/index.js",
    "server:local": "node scripts/server-local-postgres.mjs",
    "server:system-local": "node scripts/server-system-postgres.mjs",
    "db:supabase:migrate": "node scripts/apply-supabase-migrations.js",
    "db:supabase:check": "node scripts/check-supabase-connection.js",
    "start:prod": "node server/index.js",
    "cleanup:code": "node scripts/cleanup-codebase.js",
    "cleanup:code:apply": "node scripts/cleanup-codebase.js --apply",
    "cleanup:worktree": "node scripts/cleanup-worktree.js",
    "cleanup:worktree:apply": "node scripts/cleanup-worktree.js --apply",
    "maintenance:lint": "node scripts/maintenance-lint.mjs",
    "maintenance:scan": "node scripts/maintenance-stale-scan.mjs",
    "maintenance:all": "node scripts/maintenance-all.mjs",
    "secrets:scan": "node scripts/secret-scan.mjs --all",
    "secrets:scan:staged": "node scripts/secret-scan.mjs --staged",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "security:supabase:enable-leaked-password-protection": "node scripts/enable-supabase-leaked-password-protection.js",
    "check:routes": "node scripts/check-routes.js",
    "check:api-wrappers": "node scripts/check-api-wrappers.js",
    "check:shell-runtime": "node scripts/check-shell-runtime-contract.mjs",
    "test:shell-runtime": "node scripts/test-shell-runtime-contract.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
