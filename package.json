{
    "name": "barman-store",
    "version": "1.0.0",
    "description": "BARMAN STORE - E-commerce Application with Supabase Postgres",
    "private": true,
    "engines": {
        "node": "20.x"
    },
    "dependencies": {
        "bcrypt": "^5.1.0",
        "cors": "^2.8.5",
        "express": "^4.18.2",
        "fuse.js": "^7.1.0",
        "jspdf": "^4.1.0",
        "jspdf-autotable": "^5.0.7",
        "lucide-react": "^0.263.1",
        "pg": "^8.13.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-router-dom": "^6.20.0",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.1.18",
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.24",
        "postcss": "^8.5.6",
        "tailwindcss": "^4.1.18",
        "vite": "^5.0.8"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "test": "npm run test:phone && npm run test:order-flow && npm run test:po-lifecycle && npm run test:credit-ui && npm run test:category-tree",
        "test:phone": "node scripts/test-phone-validation.mjs",
        "test:order-flow": "node scripts/test-order-billing-flow.mjs",
        "test:po-lifecycle": "node scripts/test-po-lifecycle-flow.mjs",
        "test:credit-ui": "node scripts/test-credit-history-ui.mjs",
        "test:category-tree": "node scripts/test-category-tree-rules.mjs",
        "cleanup:smoke": "node scripts/cleanup-smoke-test-data.js --apply",
        "cleanup:smoke:verify": "node scripts/cleanup-smoke-test-data.js --fail-on-matches",
        "preview": "vite preview",
        "server": "node server/index.js",
        "start:prod": "node server/index.js",
        "cleanup:code": "node scripts/cleanup-codebase.js",
        "cleanup:code:apply": "node scripts/cleanup-codebase.js --apply",
        "secrets:scan": "node scripts/secret-scan.mjs --all",
        "secrets:scan:staged": "node scripts/secret-scan.mjs --staged",
        "hooks:install": "node scripts/install-hooks.mjs",
        "prepare": "node scripts/install-hooks.mjs",
        "db:supabase:check": "node scripts/check-supabase-connection.js",
        "db:supabase:migrate": "node scripts/apply-supabase-migrations.js",
        "security:supabase:enable-leaked-password-protection": "node scripts/enable-supabase-leaked-password-protection.js"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}
