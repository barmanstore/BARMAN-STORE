{
  "version": 2,
  "crons": [
    {
      "path": "/api/internal/phone-change/process",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/internal/purchase-operations/notifications/run",
      "schedule": "30 0 * * *"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
